        <mxCell id="K0ff0nCkm25C723q5XP7-2" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=default;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Taulujen lyhytkuvaukset&lt;/h1&gt;&lt;div&gt;Kuitti - Asiakkaan kopio, kertoo kaikki liput mitä ostettiin ja millä hinnalla&lt;/div&gt;&lt;p&gt;Lippu -&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Se, joka annetaan asiakkaalle&lt;/p&gt;&lt;p&gt;Tuote - Sisältää tiedon, millaisia lippuvaihtoehtoja yhteen esitykseen on sekä niiden hinnat&lt;/p&gt;&lt;p&gt;Lipputyyppi - Esim. peruslippu, lastenlippu, eläkeläinen, opiskelija...&lt;/p&gt;&lt;p&gt;Esityskerta - Yksi ilmentymä tapahtumasta. Esimerkiksi yksi teatteriesitys&lt;/p&gt;&lt;p&gt;Tapahtuma - Suurempi kokonaisuus. Esimerkiksi &quot;Teatterin Aave&quot; esitys, jossa viisi eri näytöstä (esityskertaa)&lt;/p&gt;&lt;p&gt;Jarjestaja - Sisältää tiedot tapahtuman järjestejästä. Tätä taulua voi laajentaa järjestäjän tietoja lisäämällä.&lt;/p&gt;&lt;p&gt;Paikka - Missä tapahtuma järjestetään&lt;/p&gt;&lt;p&gt;Postinumero - Sisältää kaupungin (postitoimipaikka&lt;/p&gt;" vertex="1">
          <mxGeometry height="440" width="288.93" x="961.07" y="470" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
