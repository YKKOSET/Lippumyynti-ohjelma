        </mxCell>
        <mxCell id="VD7JIYPtQpqpiOwFCi5a-50" parent="VD7JIYPtQpqpiOwFCi5a-1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=default;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Taulujen lyhytkuvaukset&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;div style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;Lipputyyppi - Esim. peruslippu, lastenlippu, eläkeläinen, opiskelija...&lt;/div&gt;&lt;div style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;Lippu - Se, joka annetaan asiakkaalle&lt;/div&gt;&lt;div style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;Ostorivi - Asiakkaan ostamat liput ja toteutunut hinta&lt;/div&gt;&lt;div style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;Osto - Asiakkaan kuitti ostetuista lipuista ja kokonaishinta&lt;/div&gt;&lt;div style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;Asiakas - Ohjelmiston jatkokehitystä varten valmiiksi luotu luokka&lt;/div&gt;&lt;div style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;Jarjestaja - Tapahtuman yhteyshenkilö&lt;/div&gt;&lt;div style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;Tapahtuma - Suurempi kokonaisuus. Esimerkiksi &quot;Teatterin Aave&quot; esitys, jossa viisi eri näytöstä (esityskertaa)&lt;/div&gt;&lt;p style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;Esityskerta - Yksi ilmentymä tapahtumasta. Esimerkiksi yksi teatteriesitys&lt;/p&gt;&lt;p style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;Paikka - Missä tapahtuma järjestetään&lt;/p&gt;&lt;p style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;Postinumero - Sisältää postitoimipaikan postinumeroon perustuen&lt;/p&gt;&lt;/h1&gt;" vertex="1">
          <mxGeometry height="330" width="640" x="840" y="470" as="geometry" />
        </mxCell>
